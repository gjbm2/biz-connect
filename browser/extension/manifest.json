{
  "manifest_version": 3,
  "name": "biz-connect: Ask Claude",
  "short_name": "Ask Claude",
  "version": "1.0.0",
  "description": "Select text on any page and hand it to Claude Code in your biz-connect workspace.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Ask Claude about this page" },
  "commands": {
    "ask-claude": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Ask Claude about the selection"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
